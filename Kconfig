DT_COMPAT_ZMK_BEHAVIOR_DISP_SWITCH := zmk,behavior-disp-switch

config ZMK_BEHAVIOR_DISP_SWITCH
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_DISP_SWITCH))
    depends on ZMK_DISPLAY

if ZMK_BEHAVIOR_DISP_SWITCH

config ZMK_DISP_SW_PEEK_MS
    int "Peek duration in ms (&disp_sw 3)"
    default 5000

config ZMK_DISP_SW_BATT_MAH
    int "Battery capacity per half in mAh (for the ETA widget)"
    default 110

config ZMK_DISP_SW_DRAIN_UA
    int "Baseline drain in uA: MCU + BLE only, screens dark, RGB off"
    default 1500
    help
      The floor the keyboard always draws. The ETA adds the OLED and RGB
      terms below on top of this whenever those are actually active, so this
      value must NOT include them.

config ZMK_DISP_SW_OLED_UA
    int "Extra drain in uA while this half's OLED is lit"
    default 550
    help
      SSD1306 controller floor plus pixel drive at the configured contrast.
      Only added while the panel is actually lit (USB, screens-on, or peek).

config ZMK_DISP_SW_RGB_FULL_UA
    int "Extra drain in uA with RGB underglow on at 100% brightness"
    default 250000
    help
      Whole-chain draw for one half at full brightness; the ETA scales it by
      the live brightness setting. Rough by nature — WS2812 current depends on
      hue and effect — but the point is directional: with the lights on, the
      ETA must collapse from days to hours.

      NOT modelled here: the chain's QUIESCENT draw. The LEDs sit on the
      ext-power rail, which stays on for the OLEDs, so they draw a little even
      with RGB "off". If real runtime is much shorter than the ETA claims,
      that is the first suspect — and &ext_power EP_OFF is the only cure
      (it takes the OLEDs down with it).

config ZMK_DISP_SW_BATT_LOW_PCT
    int "Battery percent at/below which the battery reading inverts (low-batt alert)"
    default 15

config ZMK_DISP_SW_LIMIT_WARN_PCT
    int "5h/7d usage percent at/above which the limits line inverts (near-cap warning)"
    default 85

# Custom status screen (stock widgets + battery-ETA label). The `imply`s turn
# the stock widgets on only where their role dependencies are met (layer/output
# = central only, peripheral-status = peripheral only) — no Kconfig warnings.
config ZMK_DISP_SW_STATUS_SCREEN
    bool
    default y if ZMK_DISPLAY_STATUS_SCREEN_CUSTOM
    select LV_FONT_UNSCII_8
    # stock widgets used to pull this in; our own labels need it explicitly
    select LV_USE_LABEL
    imply ZMK_WIDGET_LAYER_STATUS

endif

DT_COMPAT_ZMK_BEHAVIOR_DISP_USYNC := zmk,behavior-disp-usync

config ZMK_BEHAVIOR_DISP_USYNC
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_DISP_USYNC))
    depends on ZMK_DISPLAY

DT_COMPAT_ZMK_BEHAVIOR_DISP_UCOST := zmk,behavior-disp-ucost

config ZMK_BEHAVIOR_DISP_UCOST
    bool
    default $(dt_compat_enabled,$(DT_COMPAT_ZMK_BEHAVIOR_DISP_UCOST))
    depends on ZMK_DISPLAY
